  "validation_rules": [
    {
      "id": "BH-V04",
      "target": "interval semantics on ProperIntervals with true meets boundary",
      "mechanism": "Python UTC datetime + SHACL/SPARQL",
      "positive": "p05-valid (planned)",
      "negative": [
        "N04-false-meets-gap",
        "N04-wrong-domain"
      ],
      "status": "DEFERRED"
    },
    {
      "id": "BH-V07",
      "target": "interaction subject/reference/time/provenance and not COLREG",
      "mechanism": "SHACL Core + cross-link checks",
      "positive": "p05-valid (planned)",
      "negative": [
        "N07-no-reference",
        "N07-no-time-context"
      ],
      "status": "DEFERRED"
    },
    {
      "id": "BH-V08",
      "target": "no target behavior label leakage in ANY inference-input named instance graph",
      "mechanism": "rdflib.Dataset(default_union=False), scoped GRAPH checks",
      "positive": "p05-pre-valid (planned)",
      "negative": [
        "N08-label-leakage"
      ],
      "status": "DEFERRED"
    },
    {
      "id": "BH-V09",
      "target": "post-inference evidence, prov:Activity, score/status constraints",
      "mechanism": "SHACL + provenance lineage",
      "positive": "p05-post-valid (planned)",
      "negative": [
        "N09-no-evidence",
        "N09-no-activity",
        "N09-score-out-of-range"
      ],
      "status": "DEFERRED"
    },
    {
      "id": "BH-V10",
      "target": "no automatic behavioral to mode/COLREG inference",
      "mechanism": "OWL reasoner + mutant tests",
      "positive": "p05-valid (planned)",
      "negative": [
        "N10-equivalence-mutant",
        "N10-property-chain-mutant"
      ],
      "status": "DEFERRED"
    }
  ],
  "competency_questions": [
    {
      "id": "BH-CQ-04",
      "question": "What spatial context and direction/distance/topology descriptions characterize a TemporalUnit?",
      "variables": [
        "unit",
        "relation",
        "relationKind",
        "reference",
        "frameOrCrs",
        "time",
        "evidence"
      ],
      "rules": [
        "BH-V07"
      ],
      "oracle": "EXACT_BINDINGS_DATATYPES_AND_IRIS",
      "status": "DEFERRED"
    },
    {
      "id": "BH-CQ-05",
      "question": "Which TemporalUnits are adjacent, and which distinct ProperIntervals genuinely meet rather than having a gap?",
      "variables": [
        "unit1",
        "unit2",
        "interval1",
        "interval2",
        "end1",
        "start2",
        "meets"
      ],
      "rules": [
