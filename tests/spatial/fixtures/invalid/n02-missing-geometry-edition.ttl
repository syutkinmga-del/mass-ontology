@prefix ex: <https://w3id.org/mass-ontology/examples/p05-01#> .
@prefix bh: <https://w3id.org/mass-ontology/behavior#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix maritime: <https://w3id.org/mass-ontology/maritime#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic zone; neither a real charted maritime area nor a regulated ODD.
ex:area_01 a bh:EnvironmentSpace ;
    geo:hasGeometry ex:area_01_geometry_edition_a ,
                    ex:area_01_geometry_edition_b .

# Two separate geometry *record* identities and exact source versions.
ex:area_01_geometry_edition_a a geo:Geometry ;
    
    geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON((12.30 54.35,12.40 54.35,12.40 54.45,12.30 54.45,12.30 54.35))"^^geo:wktLiteral ;
    prov:wasDerivedFrom ex:edition_source_A .

ex:area_01_geometry_edition_b a geo:Geometry ;
    bh:geometryEditionId "synthetic-edition-B"^^xsd:string ;
    geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POLYGON((12.31 54.35,12.42 54.35,12.42 54.46,12.31 54.46,12.31 54.35))"^^geo:wktLiteral ;
    prov:wasDerivedFrom ex:edition_source_B .

ex:edition_source_A a prov:Entity .
ex:edition_source_B a prov:Entity .

# A separate vessel exists in the synthetic universe but is NOT
# an EnvironmentSpace/Geometry. Relation instances are P05-03 scope.
ex:passing_vessel a maritime:Vessel .
