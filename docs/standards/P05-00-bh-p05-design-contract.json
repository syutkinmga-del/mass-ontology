      ],
      "oracle": "EXACT_BINDINGS_AND_UTC_BOUNDARIES",
      "status": "DEFERRED"
    },
    {
      "id": "BH-CQ-06",
      "question": "What post-inference semantic interpretation has which source evidence and activity/version/status?",
