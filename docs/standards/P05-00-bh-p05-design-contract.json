      ],
      "oracle": "EXACT_BINDINGS_AND_NEGATIVE_ENTAILMENT_MUTANT",
      "status": "DEFERRED"
    },
    {
      "id": "BH-CQ-09",
      "question": "Which independent evidence (if any) supports COLREGSituation rather than label-only entailment?",
